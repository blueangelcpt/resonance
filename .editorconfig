# Indentation configuration is explicit and uses tabs (FRD section 15).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{c,cc,cpp,h,hh,hpp,inl}]
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{cmake,txt}]
indent_style = tab
indent_size = 4

[CMakeLists.txt]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,md}]
indent_style = space
indent_size = 2
