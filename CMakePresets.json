{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },

    {
      "name": "linux-release",
      "displayName": "Linux x64 release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 debug",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-sanitisers",
      "displayName": "Linux x64 with ASan and UBSan",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ML_ENABLE_ASAN": "ON",
        "ML_ENABLE_UBSAN": "ON",
        "ML_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "linux-strict",
      "displayName": "Linux x64, warnings are errors",
      "inherits": "linux-release",
      "cacheVariables": { "ML_WARNINGS_AS_ERRORS": "ON" }
    },

    {
      "name": "windows-release",
      "displayName": "Windows x64 release",
      "inherits": ["base", "vcpkg"],
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },

    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS Intel release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    }
  ],

  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-sanitisers", "configurePreset": "linux-sanitisers" },
    { "name": "linux-strict", "configurePreset": "linux-strict" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-x64", "configurePreset": "macos-x64" }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "linux-release", "inherits": "base", "configurePreset": "linux-release" },
    { "name": "linux-sanitisers", "inherits": "base", "configurePreset": "linux-sanitisers" },
    { "name": "linux-strict", "inherits": "base", "configurePreset": "linux-strict" },
    { "name": "windows-release", "inherits": "base", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "macos-arm64", "inherits": "base", "configurePreset": "macos-arm64" },
    { "name": "macos-x64", "inherits": "base", "configurePreset": "macos-x64" }
  ]
}
